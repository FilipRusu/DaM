<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
             xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/<onBoarding1Fragment>">

    <fragment
        android:id="@+id/onBoarding1Fragment"
        android:name="com.example.ejfragmentos.onBoarding1Fragment"
        android:label="fragment_on_boarding1"
        tools:layout="@layout/fragment_on_boarding1" >
        <action
            android:id="@+id/action_onBoarding1Fragment_to_onBoardin2Fragment"
            app:destination="@id/onBoardin2Fragment" />
    </fragment>
    <fragment
        android:id="@+id/onBoardin2Fragment"
        android:name="com.example.ejfragmentos.onBoardin2Fragment"
        android:label="fragment_on_boardin2"
        tools:layout="@layout/fragment_on_boardin2" >
        <action
            android:id="@+id/action_onBoardin2Fragment_to_homePage"
            app:destination="@id/homePage" />
    </fragment>
    <fragment
        android:id="@+id/homePage"
        android:name="com.example.ejfragmentos.homePage"
        android:label="fragment_home_page"
        tools:layout="@layout/fragment_home_page" />
</navigation>